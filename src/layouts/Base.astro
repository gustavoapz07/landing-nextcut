---
import "../styles/global.css";
import Marca from "../components/Marca.astro";
import { enlaceWhatsApp } from "../lib/sitio";

interface Props {
  titulo: string;
  descripcion: string;
}
const { titulo, descripcion } = Astro.props;

const enlaces = [
  { href: "#problema", texto: "El problema" },
  { href: "#como-funciona", texto: "Cómo funciona" },
  { href: "#precios", texto: "Precios" },
  { href: "#preguntas", texto: "Preguntas" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#1a1918" />
    <link rel="preload" as="image" href="/img/silla.webp" fetchpriority="high" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <script is:inline>document.documentElement.classList.add("js", "cargando");</script>
  </head>
  <body class="overflow-x-clip">
    <!-- Pantalla de carga: el boleto se dibuja, el número corre hasta A-14 y la cortina sube. -->
    <div id="cargador" aria-hidden="true">
      <div class="flex flex-col items-center">
        <svg viewBox="0 0 52 40" class="w-24 overflow-visible sm:w-28">
          <path
            data-cargador="trazo"
            d="M6 2h40a4 4 0 0 1 4 4v9a5 5 0 0 0 0 10v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4v-9a5 5 0 0 0 0-10V6a4 4 0 0 1 4-4z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            pathLength="1"
            stroke-dasharray="1"
            stroke-dashoffset="1"
          ></path>
          <path data-cargador="punteado" d="M36 6v28" stroke="currentColor" stroke-width="1.4" stroke-dasharray="2.5 2.5" opacity="0"></path>
          <circle data-cargador="punto" cx="43" cy="20" r="3" class="fill-poste-rojo" opacity="0"></circle>
        </svg>
        <p class="mt-6 font-display text-5xl leading-none font-extrabold tabular-nums">
          A-<span data-cargador="numero">01</span>
        </p>
        <p class="mt-2 text-xs tracking-[0.35em] text-hueso/50 uppercase">Tomando tu turno</p>
      </div>
    </div>

    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-tinta focus:px-4 focus:py-2 focus:text-fondo"
    >
      Ir al contenido
    </a>

    <header class="fixed inset-x-0 top-0 z-40 px-4 pt-3 sm:px-6 sm:pt-4">
      <div
        id="barra"
        data-sobre="oscuro"
        class="mx-auto flex max-w-6xl items-center justify-between gap-4 rounded-full py-2 pr-2 pl-4 transition-[background-color,box-shadow,color] duration-300"
      >
        <a href="/" aria-label="NextCut, inicio"><Marca /></a>
        <nav aria-label="Secciones" class="hidden md:block">
          <ul class="pildora flex items-center gap-1 rounded-full bg-superficie/80 p-1 ring-1 ring-borde backdrop-blur transition-colors">
            {
              enlaces.map((e) => (
                <li>
                  <a
                    href={e.href}
                    class="block rounded-full px-4 py-1.5 text-sm transition hover:bg-superficie-2"
                  >
                    {e.texto}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a
          href={enlaceWhatsApp()}
          target="_blank"
          rel="noopener"
          class="cta inline-flex items-center gap-2 rounded-full bg-tinta px-4 py-2.5 text-sm font-medium text-fondo transition"
        >
          Escríbenos <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="bg-noche px-4 pt-16 pb-10 text-hueso sm:px-6">
      <div class="mx-auto grid max-w-6xl gap-10 sm:grid-cols-[1.5fr_1fr_1fr]">
        <div>
          <Marca class="text-4xl" />
          <p class="mt-4 max-w-xs text-sm text-hueso/60">
            Fila virtual para barberías que atienden por orden de llegada. Hecho en Honduras.
          </p>
        </div>
        <div>
          <p class="text-xs tracking-[0.3em] text-hueso/50 uppercase">Página</p>
          <ul class="mt-3 space-y-2 text-sm">
            {enlaces.map((e) => <li><a href={e.href} class="hover:underline">{e.texto}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="text-xs tracking-[0.3em] text-hueso/50 uppercase">Contacto</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li>
              <a href={enlaceWhatsApp()} target="_blank" rel="noopener" class="hover:underline">
                WhatsApp
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div
        class="mx-auto mt-14 flex max-w-6xl flex-wrap justify-between gap-2 border-t border-white/10 pt-6 text-xs text-hueso/50"
      >
        <p>© 2026 NextCut</p>
        <p>Fotos de Unsplash</p>
      </div>
    </footer>

    <script>
      import { iniciar } from "../scripts/animaciones";
      iniciar();
    </script>
  </body>
</html>
