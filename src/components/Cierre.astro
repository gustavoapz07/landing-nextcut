---
import { enlaceWhatsApp, FOTOS, foto } from "../lib/sitio";

const preguntas = [
  {
    p: "¿El cliente tiene que descargar una app?",
    r: "No. Escanea el QR con la cámara y se abre una página. No crea cuenta ni pone contraseña: solo su nombre y su teléfono.",
  },
  {
    p: "¿Funciona en iPhone?",
    r: "Sí. Para recibir los avisos en iPhone hay que agregar la página a la pantalla de inicio (iOS 16.4 o más nuevo); la página lo explica paso a paso. Sin eso, el turno se sigue viendo en vivo en la página.",
  },
  {
    p: "¿Y si alguien se anota desde la casa y no llega?",
    r: "El barbero lo marca como «no llegó» y llama al siguiente. Si entran demasiados turnos de golpe desde fuera, la fila en línea se pausa sola y te avisa; los que llegan por el QR de la puerta pueden seguir anotándose.",
  },
  {
    p: "¿Necesito comprar una tele o una tablet?",
    r: "No. Con tu celular y el de tus barberos alcanza. La pantalla del local es opcional y funciona en cualquier tele o computadora con navegador.",
  },
  {
    p: "¿Cuánto tarda en estar lista?",
    r: "Te creamos la barbería, cargas tus barberos y servicios, imprimes el QR y lo pegas en la puerta. Se hace en una tarde.",
  },
  {
    p: "¿Hay contrato?",
    r: "No. Pagas mes a mes y lo dejas cuando quieras.",
  },
];
---

<section id="preguntas" class="px-4 pb-24 sm:px-6 sm:pb-32" aria-labelledby="titulo-preguntas">
  <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.8fr_1.2fr]">
    <h2
      id="titulo-preguntas"
      data-aparece
      class="font-display text-[clamp(3rem,7vw,5rem)] leading-[0.92] font-extrabold uppercase"
    >
      Lo que<br /><span class="font-light">siempre preguntan</span>
    </h2>
    <div class="divide-y divide-borde border-y border-borde" data-aparece>
      {
        preguntas.map(({ p, r }) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-medium [&::-webkit-details-marker]:hidden">
              {p}
              <span
                aria-hidden="true"
                class="grid size-8 shrink-0 place-items-center rounded-full ring-1 ring-borde transition group-open:rotate-45 group-open:bg-ladrillo group-open:text-hueso group-open:ring-ladrillo"
              >
                +
              </span>
            </summary>
            <p class="mt-3 max-w-xl text-tenue">{r}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<section class="px-4 pb-6 sm:px-6" aria-labelledby="titulo-cierre">
  <div
    class="relative mx-auto grid max-w-6xl overflow-hidden rounded-[2.5rem] bg-marino text-hueso md:grid-cols-[1.3fr_1fr]"
  >
    <div class="relative z-10 p-8 sm:p-14">
      <h2
        id="titulo-cierre"
        data-aparece
        class="font-display text-[clamp(3rem,8vw,6rem)] leading-[0.92] font-extrabold uppercase"
      >
        Este sábado,<br /><span class="font-light text-ladrillo-claro">que nadie se vaya</span>
      </h2>
      <p class="mt-5 max-w-md text-lg text-hueso/70">
        Escríbenos y la dejamos lista con tus barberos y tus precios. Los primeros 30 días van por
        nuestra cuenta.
      </p>
      <a
        href={enlaceWhatsApp()}
        target="_blank"
        rel="noopener"
        class="mt-8 inline-flex h-14 items-center gap-3 rounded-full bg-hueso px-7 font-medium text-tinta transition hover:bg-white"
      >
        <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"
          ></path></svg
        >
        Escribir por WhatsApp
      </a>
    </div>
    <img
      data-foto
      src={foto(FOTOS.local, 700, 800)}
      alt=""
      loading="lazy"
      width="700"
      height="800"
      class="h-64 w-full object-cover md:h-full [mask-image:linear-gradient(to_top,black_60%,transparent)] md:[mask-image:linear-gradient(to_right,transparent,black_35%)]"
    />
  </div>
</section>
