---
import Tele from "./Tele.astro";
import Marca from "./Marca.astro";

// Barras del resumen del dueño (clientes por hora, de ejemplo).
const horas = [
  ["9", 3], ["10", 6], ["11", 8], ["12", 5], ["1", 3], ["2", 4], ["3", 6], ["4", 7], ["5", 5],
] as const;
const maximo = Math.max(...horas.map(([, n]) => n));
---

<section data-tema="oscuro" class="bg-marino px-4 text-hueso py-24 sm:px-6 sm:py-32" aria-labelledby="titulo-paneles">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl" data-aparece>
      <p class="text-sm font-medium tracking-[0.3em] text-marino-claro uppercase">Del otro lado del mostrador</p>
      <h2
        id="titulo-paneles"
        class="mt-3 font-display text-[clamp(3rem,7vw,5.5rem)] leading-[0.92] font-extrabold uppercase"
      >
        La fila se maneja<br /><span class="font-light">con un toque</span>
      </h2>
    </div>

    <div class="mt-14 grid gap-4 lg:grid-cols-6">
      <!-- Barbero -->
      <article
        data-aparece
        class="flex flex-col rounded-[2rem] bg-superficie p-6 text-tinta lg:col-span-2"
      >
        <p class="text-xs font-medium tracking-[0.3em] text-ladrillo uppercase">Barbero</p>
        <h3 class="mt-2 font-display text-3xl leading-none font-extrabold uppercase">
          Llama al siguiente
        </h3>
        <p class="mt-2 text-tenue">
          Ve a quién atiende y quién sigue. Si alguien no llegó, lo marca y pasa al próximo.
        </p>
        <div class="mt-6 flex-1 rounded-[1.5rem] bg-fondo p-4 ring-1 ring-borde" aria-hidden="true">
          <p class="text-xs text-tenue">En la silla</p>
          <p class="font-display text-2xl font-extrabold uppercase">A-12 · Luis R.</p>
          <p class="text-xs text-tenue">Fade · 22 min</p>
          <div class="my-3 border-t border-borde"></div>
          <p class="text-xs text-tenue">Sigue</p>
          <p class="font-semibold">A-14 · Carlos M.</p>
          <div class="mt-4 grid grid-cols-[1fr_auto] gap-2">
            <span class="rounded-full bg-tinta py-3 text-center font-display text-lg font-extrabold text-fondo uppercase">
              Llamar siguiente
            </span>
            <span class="rounded-full px-3 py-3 text-xs ring-1 ring-borde">No llegó</span>
          </div>
        </div>
      </article>

      <!-- Dueño -->
      <article
        data-aparece
        style="--retraso:.08s"
        class="rounded-[2rem] bg-superficie p-6 text-tinta lg:col-span-4"
      >
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <p class="text-xs font-medium tracking-[0.3em] text-ladrillo uppercase">Dueño</p>
            <h3 class="mt-2 font-display text-3xl leading-none font-extrabold uppercase">
              El día en números
            </h3>
            <p class="mt-2 max-w-sm text-tenue">
              Cuántos atendió cada silla, cuánto entró y cuántos salieron de la fila sin cortarse.
            </p>
          </div>
          <span class="rounded-full bg-fondo px-3 py-1 text-xs ring-1 ring-borde">Hoy · ejemplo</span>
        </div>
        <div class="mt-6 grid grid-cols-3 gap-3" aria-hidden="true">
          <div class="rounded-2xl bg-noche p-4 text-hueso">
            <p class="font-display text-3xl leading-none font-extrabold whitespace-nowrap sm:text-4xl" data-contar="38">38</p>
            <p class="mt-1 text-xs text-hueso/60">atendidos</p>
          </div>
          <div class="rounded-2xl bg-fondo p-4 ring-1 ring-borde">
            <p class="font-display text-3xl leading-none font-extrabold whitespace-nowrap sm:text-4xl text-ladrillo" data-contar="4">4</p>
            <p class="mt-1 text-xs text-tenue">se fueron</p>
          </div>
          <div class="rounded-2xl bg-fondo p-4 ring-1 ring-borde">
            <p class="font-display text-3xl leading-none font-extrabold whitespace-nowrap sm:text-4xl" data-contar="6450" data-prefijo="L ">L 6,450</p>
            <p class="mt-1 text-xs text-tenue">ingresos</p>
          </div>
        </div>
        <div class="mt-6 flex h-36 items-end gap-2" aria-hidden="true">
          {
            horas.map(([h, n]) => (
              <div class="flex h-full flex-1 flex-col items-center gap-1.5">
                <div class="flex w-full flex-1 items-end">
                  <span
                    data-barra
                    class:list={["block w-full rounded-t-lg", n === maximo ? "bg-marino" : "bg-tinta/15"]}
                    style={`height:${(n / maximo) * 100}%`}
                  />
                </div>
                <span class="text-[0.65rem] text-tenue">{h}</span>
              </div>
            ))
          }
        </div>
        <p class="mt-3 text-xs text-tenue">
          Clientes por hora. La barra azul es la hora pico: ahí conviene tener todas las sillas.
        </p>
      </article>

      <!-- TV en vivo -->
      <article class="mt-10 lg:col-span-6">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-6" data-aparece>
          <div>
            <p class="text-xs font-medium tracking-[0.3em] text-marino-claro uppercase">Pantalla del local</p>
            <h3 class="mt-2 font-display text-[clamp(2.5rem,5vw,4rem)] leading-[0.9] font-extrabold uppercase">
              La fila en la tele
            </h3>
          </div>
          <p class="max-w-sm text-hueso/75">
            Así se ve en cualquier tele con navegador. Cuando un barbero llama, el turno sale en grande
            y la fila se corre sola. Se acaba el «¿quién sigue?».
          </p>
        </div>
        <div data-aparece><Tele /></div>
      </article>
    </div>
  </div>
</section>
