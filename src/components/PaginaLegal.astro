---
// Marco de las páginas de texto legal: banda oscura con el título y el cuerpo en una columna.
import Base from "../layouts/Base.astro";

interface Props {
  titulo: string;
  descripcion: string;
  actualizado: string;
}
const { titulo, descripcion, actualizado } = Astro.props;
---

<Base titulo={`${titulo} · NextCut`} descripcion={descripcion} texto>
  <section data-tema="oscuro" class="bg-noche px-4 pt-36 pb-14 text-hueso sm:px-6 sm:pt-44">
    <div class="mx-auto max-w-3xl">
      <p class="text-sm font-medium tracking-[0.3em] text-ladrillo-claro uppercase">Legal</p>
      <h1 class="mt-3 font-display text-[clamp(3rem,9vw,5.5rem)] leading-[0.92] font-extrabold uppercase">
        {titulo}
      </h1>
      <p class="mt-4 text-sm text-hueso/60">Última actualización: {actualizado}</p>
    </div>
  </section>
  <article class="legal mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
    <slot />
  </article>
</Base>

<style>
  .legal :global(h2) {
    margin-top: 2.75rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }
  .legal :global(h2:first-child) {
    margin-top: 0;
  }
  .legal :global(p),
  .legal :global(ul) {
    margin-top: 0.9rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .legal :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal :global(li + li) {
    margin-top: 0.4rem;
  }
  .legal :global(a) {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
