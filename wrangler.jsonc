// Landing estática en Cloudflare Pages, conectada al repo de GitHub:
// cada push a main se compila (npm run build) y se publica solo.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "landing-nextcut",
  "compatibility_date": "2026-11-01",
  "pages_build_output_dir": "./dist"
}
